# Angular workspace ignore rules.
#
# The workspace sits at the repository root, so leading-slash anchors resolve
# correctly. Patterns left unanchored are intentional — they should match at any
# depth, including a nested package added later.

# ---------------------------------------------------------------- dependencies
/node_modules
jspm_packages/
bower_components/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------------------------------------------------------------- build output
/dist
/tmp
/out-tsc
/bazel-out
/build
*.tsbuildinfo

# -------------------------------------------------------------- Angular caches
# .angular/cache is regenerated by the CLI on every build and is large (~20 MB).
/.angular
/.sass-cache
/connect.lock

# --------------------------------------------------------------------- testing
/coverage
*.lcov
.nyc_output/
libpeerconnection.log
testem.log
/typings

# ------------------------------------------------------------------ playwright
playwright-report/
test-results/
blob-report/
.playwright/

# ----------------------------------------------------------------- environment
# src/environments/*.ts hold non-secret build flags only and ARE tracked.
# Anything below carries real credentials and must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets.json

# --------------------------------------------------------------------- editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------------- system
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----------------------------------------------------------------------- logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
